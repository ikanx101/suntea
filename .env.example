# Koneksi database PostgreSQL. Untuk dev lokal lihat docker-compose.yml.
# Di Railway, isi dengan referensi variable Postgres plugin: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://santi:santi_dev_password@localhost:5432/santi_toko?schema=public"

# URL publik aplikasi (dipakai NextAuth untuk callback). Di Railway isi dengan domain yang diberikan Railway.
NEXTAUTH_URL="http://localhost:3000"

# Secret untuk enkripsi session/JWT NextAuth. WAJIB diisi nilai acak yang kuat & rahasia.
# Generate contoh: `openssl rand -base64 32`
AUTH_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Kredensial akun admin (Santi) yang akan dibuat oleh seed script (`npx prisma db seed`).
# Setelah seed berhasil & login pertama sukses, disarankan ganti password lewat halaman Pengaturan.
ADMIN_EMAIL="santi@example.com"
ADMIN_PASSWORD="ganti-password-ini"
